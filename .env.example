# Published GHCR image version used by Docker Compose.
MITMPROXY_GRID_VERSION=2.1.0

# Automatic instance lifespan in seconds (default 1800 = 30 min).
INSTANCE_TTL=1800

# Maximum decoded body size for bodyBase64 payloads in bytes (default 50 MB).
MAX_BODY_SIZE=52428800

# Proxy port range owned by each standalone grid or worker.
PORT_START=10000
PORT_END=10009

# Distributed mode heartbeat and stale-worker thresholds in seconds.
WORKER_REGISTER_INTERVAL=5
WORKER_STALE_AFTER=20

# Existing Docker network shared with Selenium Grid for docker-compose.scaled.yml.
AUTOMATION_NETWORK=selenium-grid

# Host port used to expose the coordinator REST API.
MITMPROXY_GRID_API_PORT=8090
